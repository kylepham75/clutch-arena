# Copy this file to .env.local, then set your key there. Never use NEXT_PUBLIC_ for it.

# Option 1: Groq (Recommended: Free, ultra-fast Llama 3.3, get key at console.groq.com)
GROQ_API_KEY=your-groq-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Option 2: Google Gemini (get key at aistudio.google.com)
# GOOGLE_GENERATIVE_AI_API_KEY=your-api-key-here
# GEMINI_MODEL=gemini-2.5-flash

# Multiplayer Engine (PartyKit - sub-30ms edge WebSockets for Arena)
# In dev: 127.0.0.1:1999 (run `npm run party:dev`)
# In production: clutch-arena.<your-username>.partykit.dev (run `npm run party:deploy`)
NEXT_PUBLIC_PARTYKIT_HOST=
