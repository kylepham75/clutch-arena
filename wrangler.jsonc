{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "clutch-arena-realtime",
  "main": "party/worker.ts",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "Arena",
        "class_name": "Arena"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Arena"]
    }
  ]
}
